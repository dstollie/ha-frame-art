{
  "name": "@frame-art/frame-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Samsung The Frame art channel (com.samsung.art-app) in TypeScript, plus a fake Frame for tests",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
